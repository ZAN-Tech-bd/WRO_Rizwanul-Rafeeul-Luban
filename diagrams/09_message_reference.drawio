          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;checksum&lt;/b&gt;&lt;br&gt;2" role="peripheral" status="" placeholders="1" id="fld13">
          <mxCell parent="bnd_msg" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F5F3;strokeColor=#0F766E;strokeWidth=1.4;fontFamily=Arial;fontSize=9;fontColor=#115E59;align=center;verticalAlign=middle;spacing=6;" vertex="1">
