  <diagram id="wro_rrl_02-wiring" name="02-wiring">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1840" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
