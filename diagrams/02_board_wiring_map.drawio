          </mxCell>
        </UserObject>
        <UserObject label="02 — How Every Board Is Wired" role="title" status="" placeholders="1" id="title">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#0F172A;spacing=0;connectable=0;" vertex="1">
