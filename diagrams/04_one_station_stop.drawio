        <UserObject label="&lt;b&gt;STEP 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The card is read&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#7F1D1D'&gt;If the same card is read again within 1.5 seconds, it is ignored.&lt;/font&gt;" role="phase" status="" placeholders="1" id="ph1">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="226" width="200" height="118" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Stop, then start talking&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#7F1D1D'&gt;If the speaker board is missing, the robot stays stopped rather than driving off in silence.&lt;/font&gt;" role="phase" status="" placeholders="1" id="ph2">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="352" width="200" height="178" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Take the photo, 2 seconds in&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#7F1D1D'&gt;If the talk has already stopped when those 2 seconds are up, the photo is cancelled. A photo is only ever taken while the robot is talking.&lt;/font&gt;" role="phase" status="" placeholders="1" id="ph3">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="538" width="200" height="262" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 4&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The photo reaches the staff screen&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#7F1D1D'&gt;A half-sent photo is thrown away and the old one kept.&lt;/font&gt;" role="phase" status="" placeholders="1" id="ph4">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="808" width="200" height="144" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The talk ends, the robot moves on&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#7F1D1D'&gt;If the speaker never says “finished”, the robot gives up after 90 seconds and stays stopped.&lt;/font&gt;" role="phase" status="" placeholders="1" id="ph5">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="960" width="200" height="196" as="geometry" />
          </mxCell>
        </UserObject>
