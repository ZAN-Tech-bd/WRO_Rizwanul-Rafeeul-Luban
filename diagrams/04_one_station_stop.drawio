        </UserObject>
        <UserObject label="&lt;b&gt;9&lt;/b&gt; · sends the photo over Wi-Fi" role="wire-label" status="" placeholders="1" id="m9_t">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=95;strokeColor=none;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=4;shadow=0;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="1315" y="728" width="202" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;10&lt;/b&gt; · hub writes it to a scratch file, checks the size and the JPEG start/end marks, then files it in the gallery with a new number.&lt;br&gt;Once there are more than 12 photos, the oldest one is deleted." role="wire-label" status="" placeholders="1" id="m10">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;fillOpacity=95;strokeColor=#94A3B8;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#475569;align=center;verticalAlign=middle;spacing=4;shadow=0;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="1321" y="826" width="420" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m11_a">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="1531" y="950" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m11_b">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="1751" y="950" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;11&lt;/b&gt; · the staff page asks “anything new?” every 1.5 s&lt;br&gt;and now sees a new photo number" role="wire-label" status="" placeholders="1" id="m11_t">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=95;strokeColor=none;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=4;shadow=0;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="1545" y="894" width="192" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m12_a">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="1071" y="1010" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m12_b">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="606" y="1010" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;12&lt;/b&gt; · “track finished”" role="wire-label" status="" placeholders="1" id="m12_t">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=95;strokeColor=none;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=4;shadow=0;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="620" y="968" width="437" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m13_a">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="606" y="1066" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m13_b">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="846" y="1066" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;13&lt;/b&gt; · the word &lt;b&gt;START&lt;/b&gt;" role="wire-label" status="" placeholders="1" id="m13_t">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=95;strokeColor=none;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=4;shadow=0;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="620" y="1024" width="212" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m14_a">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="846" y="1122" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" role="anchor" status="" placeholders="1" id="m14_b">
          <mxCell parent="1" style="shape=rect;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="606" y="1122" width="1" height="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;14&lt;/b&gt; · &lt;b&gt;STATE:RUNNING&lt;/b&gt; — rolling on to the next card" role="wire-label" status="" placeholders="1" id="m14_t">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fillOpacity=95;strokeColor=none;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=4;shadow=0;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry x="620" y="1080" width="212" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;WHAT THE ARROWS MEAN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;━━━▶ &lt;b&gt;Words down a wire&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#64748B&quot;&gt;  short typed lines between two boards&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1F4E78&quot;&gt;━━━▶ &lt;b&gt;Over Wi-Fi&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#64748B&quot;&gt;  a file or a page request&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0F766E&quot;&gt;━━━▶ &lt;b&gt;Something physical&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#64748B&quot;&gt;  a card coming into range&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;▭ &lt;b&gt;Grey box&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#64748B&quot;&gt;  a board doing something by itself — no message sent&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0F766E&quot;&gt;▮ &lt;b&gt;Bar on the robot line&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#64748B&quot;&gt;  the whole time the robot counts as “talking”&lt;/font&gt;" role="legend" status="" placeholders="1" id="legend">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=8;shadow=0;connectable=0;" vertex="1">
            <mxGeometry x="52" y="1190" width="400" height="226" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;THE TIMINGS THAT MATTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.5 s&lt;/b&gt; — same card read again inside this window is ignored.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 s&lt;/b&gt; — the wait between the talk starting and the photo being taken. This is why the picture shows the robot already parked and settled.&lt;br&gt;&lt;br&gt;&lt;b&gt;1.5 s minimum&lt;/b&gt; — a “finished” message arriving sooner than this is treated as left over from the previous track and ignored.&lt;br&gt;&lt;br&gt;&lt;b&gt;90 s maximum&lt;/b&gt; — if “finished” never arrives, the robot stops waiting and stays put.&lt;br&gt;&lt;br&gt;&lt;b&gt;1.5 s&lt;/b&gt; — how often the staff page asks the hub for news." role="legend" status="" placeholders="1" id="timing">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=8;shadow=0;connectable=0;" vertex="1">
            <mxGeometry x="476" y="1190" width="400" height="226" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;WHY IT IS BUILT THIS WAY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Stop first, then talk.&lt;/b&gt; Every card that has a sound file parks the robot before the sound starts, so nobody is chasing a moving robot.&lt;br&gt;&lt;br&gt;&lt;b&gt;The 2-second wait costs nothing.&lt;/b&gt; The robot does not freeze during it. It keeps listening to the card reader, the speaker and the motor helper, and only fires the camera when the moment arrives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Moving again is not on a timer.&lt;/b&gt; The robot waits for the speaker to say it has finished. A short or broken track means it stays stopped." role="legend" status="" placeholders="1" id="why">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=8;shadow=0;connectable=0;" vertex="1">
            <mxGeometry x="900" y="1190" width="460" height="226" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;WHERE THIS COMES FROM&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every step was read out of the running code:&lt;br&gt;&lt;br&gt;• the card handling and the 2-second reminder live in the robot's main loop&lt;br&gt;• the STOP / START words and the replies are in the Nano sketch&lt;br&gt;• the throw-away frames and the JPEG squeeze are in the camera firmware&lt;br&gt;• the scratch file, the marker check and the 12-photo limit are in the hub&lt;br&gt;&lt;br&gt;&lt;b&gt;Not shown:&lt;/b&gt; what happens when the emergency button is pressed. That overrules all of this — see sheet 05." role="legend" status="" placeholders="1" id="source">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=8;shadow=0;connectable=0;" vertex="1">
            <mxGeometry x="1384" y="1190" width="424" height="226" as="geometry" />
          </mxCell>
        </UserObject>
