        <UserObject label="&lt;b&gt;STEP 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Someone raises the alarm&lt;/b&gt;&lt;br&gt;&lt;br&gt;Either the physical button, or the switch on the staff page. Both end up in exactly the same place." role="phase" status="" placeholders="1" id="ph1">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="220" width="200" height="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The hub shouts it out&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nobody replies to these shouts. The hub never learns whether the robot heard — so it keeps shouting." role="phase" status="" placeholders="1" id="ph2">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="390" width="200" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The robot takes over&lt;/b&gt;&lt;br&gt;&lt;br&gt;This is the &lt;b&gt;first&lt;/b&gt; thing the robot's loop does — before it looks at any card, before it checks the speaker. Nothing the tour is doing is allowed to hold the robot at a station." role="phase" status="" placeholders="1" id="ph3">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="570" width="200" height="260" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 4&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;While the alarm is up&lt;/b&gt;&lt;br&gt;&lt;br&gt;The robot drives. It is no longer a tour guide — it is heading for the end of the rail." role="phase" status="" placeholders="1" id="ph4">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="840" width="200" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;STEP 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Someone clears it&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hold the button 3 seconds, or switch it off on the staff page. Again, both do the same thing." role="phase" status="" placeholders="1" id="ph5">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.4;fontFamily=Arial;fontSize=10;fontColor=#334155;align=left;verticalAlign=middle;spacing=6;" vertex="1">
            <mxGeometry x="52" y="1020" width="200" height="230" as="geometry" />
          </mxCell>
        </UserObject>
