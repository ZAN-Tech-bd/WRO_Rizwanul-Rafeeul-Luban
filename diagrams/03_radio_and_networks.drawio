          <mxCell parent="1" style="swimlane;startSize=30;horizontal=1;rounded=1;arcSize=10;container=1;recursiveResize=0;pointerEvents=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;shadow=0;" vertex="1">
            <mxGeometry x="52" y="124" width="1576" height="580" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Wi-Fi network A  ·  name: MuseumHub  ·  password: museum2026  ·  the hub hands out addresses" role="runtime-boundary" status="active" placeholders="1" id="net_a">
          <mxCell parent="bnd_ch1" style="swimlane;startSize=30;horizontal=1;rounded=1;arcSize=10;container=1;recursiveResize=0;pointerEvents=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;swimlaneFillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;shadow=0;" vertex="1">
            <mxGeometry x="24" y="46" width="730" height="390" as="geometry" />
