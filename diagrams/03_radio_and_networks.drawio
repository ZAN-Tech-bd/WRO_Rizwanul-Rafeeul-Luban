        <UserObject label="03 — Who Talks To Whom Without Wires" role="title" status="" placeholders="1" id="title">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#0F172A;spacing=0;connectable=0;" vertex="1">
            <mxGeometry x="60" y="44" width="1260" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Two separate Wi-Fi networks, plus a direct board-to-board radio. All three sit on channel 1, and that is not a coincidence." role="subtitle" status="" placeholders="1" id="subtitle">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#475569;spacing=0;connectable=0;" vertex="1">
            <mxGeometry x="62" y="84" width="1240" height="24" as="geometry" />
          </mxCell>
        </UserObject>
