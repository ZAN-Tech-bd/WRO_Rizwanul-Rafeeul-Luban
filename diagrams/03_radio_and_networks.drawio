          </mxCell>
        </UserObject>
        <UserObject label="" role="link" placeholders="1" id="l_camping">
          <mxCell parent="net_a" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Arial;fontSize=10;fontColor=#1F2937;strokeColor=#64748B;strokeWidth=1.7;dashed=1;dashPattern=8 4 1 4;endArrow=open;endFill=0;endSize=9;exitX=0;exitY=0.75;entryX=1;entryY=0.95;curved=0;" edge="1" source="cam" target="hub">
            <mxGeometry relative="1" as="geometry">
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" role="link" placeholders="1" id="l_eng">
          <mxCell parent="net_b" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Arial;fontSize=10;fontColor=#1F2937;strokeColor=#1F4E78;strokeWidth=2.2;endArrow=block;endFill=1;endSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.35;curved=0;" edge="1" source="engineer" target="robot">
            <mxGeometry relative="1" as="geometry">
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" role="link" placeholders="1" id="l_espnow">
          <mxCell parent="bnd_ch1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Arial;fontSize=10;fontColor=#1F2937;strokeColor=#C62828;strokeWidth=3.4;endArrow=block;endFill=1;endSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=1;curved=0;" edge="1" source="hub" target="robot">
            <mxGeometry relative="1" as="geometry">
