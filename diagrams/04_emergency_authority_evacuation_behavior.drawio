            <mxGeometry height="40" width="330" x="246" y="756" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Robot emergency state is owned locally; Hub owns only the shared Boolean. A late/rebooted Robot is resynced by the 2 s periodic broadcast, not by an ACK." placeholders="1" id="state_note">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.1;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#334155;fontSize=8.6;align=left;" vertex="1">
            <mxGeometry height="72" width="206" x="586" y="756" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" placeholders="1" id="risk_panel_bg">
          <mxCell parent="1" style="swimlane;startSize=26;horizontal=1;rounded=1;arcSize=8;container=1;recursiveResize=0;pointerEvents=0;html=1;whiteSpace=wrap;fillColor=#FFFBEB;swimlaneFillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#7C2D12;align=left;spacingLeft=12;shadow=0;" vertex="1">
            <mxGeometry height="186" width="768" x="820" y="660" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SAFETY / RISK BOUNDARY" placeholders="1" id="risk_panel_title">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#7C2D12;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry height="16" width="400" x="836" y="666" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;No ACK / auth / replay filtering&lt;/b&gt; on ESP-NOW — any valid broadcaster can raise or clear state" placeholders="1" id="risk_ack">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#7C2D12;fontSize=8.8;align=left;" vertex="1">
            <mxGeometry height="60" width="235" x="836" y="696" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Channel-1 dependency&lt;/b&gt; — ESP-NOW init / interference / mismatch can block evacuation with no end-to-end confirmation at Hub" placeholders="1" id="risk_chan">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#7C2D12;fontSize=8.8;align=left;" vertex="1">
            <mxGeometry height="60" width="250" x="1081" y="696" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Hub reboot&lt;/b&gt; boots emergency=false; the 2 s periodic state resyncs a late or rebooted Robot" placeholders="1" id="risk_reboot">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#7C2D12;fontSize=8.8;align=left;" vertex="1">
            <mxGeometry height="60" width="230" x="1341" y="696" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;No obstacle / end-position sensor beyond RFID END.&lt;/b&gt; Nano START/STOP is commanded but NOT acknowledged before the state transition proceeds." placeholders="1" id="risk_sensor">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#7C2D12;fontSize=8.8;align=left;" vertex="1">
            <mxGeometry height="68" width="440" x="836" y="764" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Mega display has NO active integration edge&lt;/b&gt; — it cannot receive or announce emergency in the working combo (see footnote)." placeholders="1" id="risk_mega">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#7C2D12;fontSize=8.8;align=left;" vertex="1">
            <mxGeometry height="68" width="288" x="1284" y="764" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#C62828&#39;&gt;&lt;b&gt;━━━▶ emergency command / state&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#DC2626&#39;&gt;&lt;b&gt;┄┄┄▶ periodic 2 s rebroadcast&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#16A34A&#39;&gt;&lt;b&gt;━━━▶ explicit recovery (clear / fresh START)&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#334155&#39;&gt;&lt;b&gt;— guard label [ ]&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;font color=&#39;#D97706&#39;&gt;&lt;b&gt;▣ risk&lt;/b&gt;&lt;/font&gt;" placeholders="1" id="legend">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.1;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#334155;fontSize=9.0;align=left;verticalAlign=top;spacing=6;connectable=0;pointerEvents=0;" vertex="1">
            <mxGeometry height="52" width="752" x="68" y="856" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AUTHORITY&lt;/b&gt; · current Hub / Robot / Nano source. Hub owns runtime state and relays it, but is &lt;b&gt;NOT&lt;/b&gt; the exclusive origin (three origins). Robot is emergency-first; during emergency only END (A3 C0 38 15) is honored. Clear re-latches stopped; a fresh START (18 C4 0F BA) is required. &lt;b&gt;Mega display is not integrated&lt;/b&gt; — no emergency edge exists in the working combo." placeholders="1" id="authority">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.1;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#334155;fontSize=9.0;align=left;verticalAlign=top;spacing=6;connectable=0;pointerEvents=0;" vertex="1">
