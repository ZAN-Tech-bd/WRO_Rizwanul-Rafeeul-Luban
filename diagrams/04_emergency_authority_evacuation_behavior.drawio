        <UserObject label="HUB&lt;br&gt;emergency = false" placeholders="1" id="st_hub_off">
          <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F4E78;strokeWidth=1.5;fontFamily=Arial;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=5;shadow=0;fontColor=#16324F;fontSize=9.0;" vertex="1">
