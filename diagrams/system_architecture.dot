digraph system_architecture {
    rankdir=TD;
    node [shape=box, style="filled,rounded", fontname="Arial"];
    edge [fontname="Arial"];
    
    Robot [label="Smart Museum Robot", fillcolor="#C8E6C9"];
    ESP32 [label="ESP32 Brain", fillcolor="#BBDEFB"];
    Hub [label="Hub Dashboard", fillcolor="#FFE0B2"];
    RFID [label="RFID Reader", fillcolor="#E1BEE7"];
    LFR [label="Line Follower", fillcolor="#FFCDD2"];
    MP3 [label="DFPlayer", fillcolor="#F8BBD0"];
    CAM [label="Camera", fillcolor="#B2EBF2"];
    Display [label="TFT Display", fillcolor="#FFF9C4"];
    Web [label="Web Dashboard", fillcolor="#DCEDC8"];
    Gallery [label="Photo Gallery", fillcolor="#B3E5FC"];
    
    Robot -> ESP32;
    Robot -> Hub;
    ESP32 -> RFID;
    ESP32 -> LFR;
    ESP32 -> MP3;
    ESP32 -> CAM;
    ESP32 -> Display;
    Hub -> Web;
    Hub -> Gallery;
}