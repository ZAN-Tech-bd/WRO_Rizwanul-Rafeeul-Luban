    ESP32 -> Camera [label="SHOOT command"];
    Camera -> Camera [label="Capture Photo"];
    Camera -> Hub [label="Upload (HTTP)"];
    ESP32 -> DFPlayer [label="Play Track"];
    DFPlayer -> Visitor [label="Audio Output"];
    ESP32 -> Hub [label="Location (ESP-NOW)"];
    Hub -> Hub [label="Update Dashboard"];
    ESP32 -> Nano [label="START command"];
    Nano -> Nano [label="Line Following"];
}